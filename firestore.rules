rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user doc; staff can read all
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (isLecturer() && resource.data.role == 'student')
      );
    }

    // Authenticated users can read student profiles (used for profile uniqueness checks);
    // students can only write their own profile, staff can write all.
    match /students/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isStaff());
    }

    // Only lecturers can create/update sessions; authenticated users can read sessions
    match /attendanceSessions/{sessionId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isLecturer();
    }

    // Students can create their own records (one per checkpoint enforced in app logic)
    // Staff can read all records
    match /attendanceRecords/{recordId} {
      allow read:  if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && isLecturer();
    }

    // Students can create/read their own absence notices; staff can read all.
    match /absenceNotices/{noticeId} {
      allow read: if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && isLecturer();
    }

    // Attendance overrides (manual adjustments by lecturers).
    // Students can read their own overrides; staff can read all; only lecturers can write.
    match /attendanceOverrides/{overrideId} {
      allow read: if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow write: if request.auth != null && isLecturer();
    }

    // Event log entries for audit trail.
    match /eventLogs/{logId} {
      allow read: if request.auth != null && isStaff();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Live Lesson Playground ─────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isStaff();
      allow update: if request.auth != null && isStaff();

      // Presence: any authenticated user can write their own entry
      match /presence/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Canvas: staff write, everyone reads
      match /canvas/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isStaff();
      }

      // Polls: staff create, anyone authenticated can update (for votes)
      match /polls/{pollId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null && isStaff();
        allow update: if request.auth != null;
      }

      // Checklist items: staff write, everyone reads
      match /checklistItems/{itemId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && isStaff();
      }

      // Checklist completions: students write their own, everyone reads
      match /checklistCompletions/{completionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null &&
          resource.data.userId == request.auth.uid;
      }
    }

    // Archived sessions: staff read/write
    match /archivedSessions/{sessionId} {
      allow read:  if request.auth != null && isStaff();
      allow write: if request.auth != null && isStaff();
    }

    // Notice board: all authenticated users can read; only staff can write.
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isStaff();
    }

    // MBI802 DBMS quiz results.
    // Students create their own results; staff can read all results.
    match /mbi802QuizResults/{resultId} {
      allow read:  if request.auth != null && (
        resource.data.studentUid == request.auth.uid || isStaff()
      );
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ER MCQ quiz results (one document per student, updated on each attempt).
    // Students can read/write their own doc; staff can read all.
    match /erMcqResults/{studentUid} {
      allow read:  if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow update: if request.auth != null && request.auth.uid == studentUid;
      allow delete: if false;
    }

    function isStaff() {
      return isLecturer() || isTeachingAssistant();
    }

    function isLecturer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer';
    }

    function isTeachingAssistant() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teachingAssistant';
    }
  }
}
