rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user doc; staff can read all
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && (
        request.auth.uid == uid ||
        (isLecturer() && resource.data.role == 'student')
      );
    }

    // Authenticated users can read student profiles (used for profile uniqueness checks);
    // students can only write their own profile, staff can write all.
    match /students/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isStaff());
    }

    // Only lecturers can create/update sessions; authenticated users can read sessions
    match /attendanceSessions/{sessionId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isLecturer();
    }

    // Students can create their own records (one per checkpoint enforced in app logic)
    // Staff can read all records
    match /attendanceRecords/{recordId} {
      allow read:  if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && isLecturer();
    }

    // Students can create/read their own absence notices; staff can read all.
    match /absenceNotices/{noticeId} {
      allow read: if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && isLecturer();
    }

    // Attendance overrides (manual adjustments by lecturers).
    // Students can read their own overrides; staff can read all; only lecturers can write.
    match /attendanceOverrides/{overrideId} {
      allow read: if request.auth != null && (resource.data.studentUid == request.auth.uid || isStaff());
      allow write: if request.auth != null && isLecturer();
    }

    // Event log entries for audit trail.
    match /eventLogs/{logId} {
      allow read: if request.auth != null && isStaff();
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Live Lesson Playground ─────────────────────────────────
    match /sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && isStaff();
      allow update: if request.auth != null && isStaff();

      // Presence: any authenticated user can write their own entry
      match /presence/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Canvas: staff write, everyone reads
      match /canvas/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isStaff();
      }

      // Polls: staff create, anyone authenticated can update (for votes)
      match /polls/{pollId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null && isStaff();
        allow update: if request.auth != null;
      }

      // Checklist items: staff write, everyone reads
      match /checklistItems/{itemId} {
        allow read:  if request.auth != null;
        allow write: if request.auth != null && isStaff();
      }

      // Checklist completions: students write their own, everyone reads
      match /checklistCompletions/{completionId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null &&
          resource.data.userId == request.auth.uid;
      }
    }

    // Archived sessions: staff read/write
    match /archivedSessions/{sessionId} {
      allow read:  if request.auth != null && isStaff();
      allow write: if request.auth != null && isStaff();
    }

    // Notice board: all authenticated users can read; only staff can write.
    match /notices/{noticeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isStaff();
    }

    // Video lessons managed by lecturers — readable by all authenticated users,
    // writable only by staff.
    match /videoLessons/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isStaff();
    }

    // MBI802 DBMS quiz results.
    // Students create their own results; staff can read all results.
    match /mbi802QuizResults/{resultId} {
      allow read:  if request.auth != null && (
        resource.data.studentUid == request.auth.uid || isStaff()
      );
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ER MCQ quiz results (one document per student, updated on each attempt).
    // Students can read/write their own doc; staff can read all.
    match /erMcqResults/{studentUid} {
      allow read:  if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow update: if request.auth != null && request.auth.uid == studentUid;
      allow delete: if false;
    }

    // Agile Scrum MCQ quiz results (one document per student, updated on each attempt).
    // Students can read/write their own doc; staff can read all.
    match /agileScrumMcqResults/{studentUid} {
      allow read:  if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow update: if request.auth != null && request.auth.uid == studentUid;
      allow delete: if false;
    }

    // SQL Practice Lab — one document per student.
    // Students read/write their own doc (tasks field only via app logic).
    // Staff can read all docs and update verification fields.
    match /sqlPractice/{studentUid} {
      allow read: if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow update: if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow delete: if false;
    }

    // Employment survey — one document per student (uid is the doc ID).
    // Students create/update their own response; staff can read all responses.
    match /employmentSurvey/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isStaff());
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // ── Arena — 1v1 Live Duels ─────────────────────────────────
    // ELO ratings: any auth user can read (for leaderboard); own doc to write.
    match /eloRatings/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Duel invites: from/to can read; sender creates; any auth user can update
    // (accepting = any authenticated user setting status to 'accepted').
    match /duelInvites/{inviteId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid   == request.auth.uid ||
        resource.data.toUid   == null
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.fromUid == request.auth.uid;
    }

    // Duel rooms: any auth can read (spectate); either player can create/update.
    match /duelRooms/{roomId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        resource.data.p1.uid == request.auth.uid ||
        resource.data.p2.uid == request.auth.uid
      );
      match /answers/{answerId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null &&
          request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Ghost records: anyone can read; any authenticated user can write
    // (app logic enforces only updating when faster).
    match /duelGhosts/{questionId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null;
    }

    // ── Daily Duel ─────────────────────────────────────────────
    // Challenges posted by staff — one document per day (doc ID = YYYY-MM-DD).
    // All authenticated users can read; only staff can write.
    match /duelChallenges/{dateKey} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isStaff();
    }

    // Duel responses — students create their own immutable submission.
    // All authenticated users can read (needed for live leaderboard).
    // Staff can update for moderation; no deletes.
    match /duelResponses/{responseId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid;
      allow update: if request.auth != null && isStaff();
      allow delete: if false;
    }

    // Duel stats — one document per student (doc ID = uid).
    // Students read/write their own doc; staff can read all.
    match /duelStats/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isStaff());
      allow write: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }

    // SQL Race Challenges — readable by all authenticated; writable by staff only
    match /sqlRaceChallenges/{challengeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isStaff();
    }

    // SQL Exam Results — one document per student (doc ID = uid).
    // Students can read/write their own doc; staff can read all.
    match /sqlExamResults/{studentUid} {
      allow read:  if request.auth != null && (request.auth.uid == studentUid || isStaff());
      allow create: if request.auth != null && request.auth.uid == studentUid;
      allow update: if request.auth != null && request.auth.uid == studentUid;
      allow delete: if false;
    }

    // SQL Exam Certificates — public read (shareable link without auth), student write own.
    match /sqlExamCertificates/{certId} {
      allow read:  if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // SQL Race Submissions — students create own; staff can read all and update (override)
    // Correct submissions are readable by all authenticated users (public race data for the track)
    match /sqlRaceSubmissions/{submissionId} {
      allow read: if request.auth != null && (
        resource.data.studentUid == request.auth.uid ||
        resource.data.isCorrect == true ||
        isStaff()
      );
      allow create: if request.auth != null &&
        request.resource.data.studentUid == request.auth.uid;
      allow update: if request.auth != null && isStaff();
      allow delete: if false;
    }

    // Peer Kudos — students send to each other; each student reads their own sent/received kudos.
    match /kudos/{kudoId} {
      allow read: if request.auth != null && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid ||
        isStaff()
      );
      allow create: if request.auth != null &&
        request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if false;
    }

    function isStaff() {
      return isLecturer() || isTeachingAssistant();
    }

    function isLecturer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer';
    }

    function isTeachingAssistant() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teachingAssistant';
    }
  }
}
