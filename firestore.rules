rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own user doc; lecturers can read all
    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isLecturer());
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Authenticated users can read student profiles (used for profile uniqueness checks);
    // students can only write their own profile, lecturers can write all.
    match /students/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == uid || isLecturer());
    }

    // Only lecturers can create/update sessions; authenticated users can read active sessions
    match /attendanceSessions/{sessionId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && isLecturer();
    }

    // Students can create their own records (one per checkpoint enforced in app logic)
    // Lecturers can read all records
    match /attendanceRecords/{recordId} {
      allow read:  if request.auth != null && (resource.data.studentUid == request.auth.uid || isLecturer());
      allow create: if request.auth != null && request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if request.auth != null && isLecturer();
    }

    function isLecturer() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'lecturer';
    }
  }
}
